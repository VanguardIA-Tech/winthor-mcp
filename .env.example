# winthor-mcp — exemplo de configuração.
#
# Copie este arquivo para `.env` e troque TODOS os valores pelos da sua
# instalação. Os valores abaixo são fictícios e não funcionam em lugar nenhum.
# O `.env` está no .gitignore: não versione o arquivo preenchido.

# --- Oracle do WinThor (obrigatório) -----------------------------------------

# Host do Oracle onde o ERP guarda os dados.
WINTHOR_DB_HOST=oracle.exemplo.local

# Porta do listener Oracle. Padrão: 1521.
WINTHOR_DB_PORT=1521

# Service name do banco (Easy Connect, driver thin). Não é SID.
WINTHOR_DB_SERVICE=WINT

# Usuário Oracle. Use uma conta somente leitura, dedicada ao MCP.
WINTHOR_DB_USER=consulta_mcp

# Senha do usuário Oracle acima.
WINTHOR_DB_PASSWORD=troque-esta-senha

# Dono das tabelas do ERP. Deixe vazio se for o mesmo usuário que lê.
WINTHOR_DB_SCHEMA=WINTHOR

# --- WinThor Anywhere (opcional) ---------------------------------------------

# Base do WTA, no formato http://host:porta. Sem ela o servidor fica só leitura
# e não executa rotina nenhuma. Veja no README como descobrir a porta.
WINTHOR_WTA_URL=http://winthor.exemplo.local:8080

# Tempo máximo, em segundos, de espera por uma chamada REST ao WTA.
WINTHOR_WTA_TIMEOUT_SEGUNDOS=30

# O WTA costuma responder por HTTPS com certificado próprio atrás do nginx da
# empresa. Deixe false para não verificar o certificado numa rede interna.
WINTHOR_WTA_VERIFY_TLS=true

# --- Identidade de quem usa (opcional) ---------------------------------------

# Matrícula do WinThor. É dela que sai a permissão aplicada pelo servidor.
WINTHOR_USUARIO=1234

# Senha do WinThor dessa mesma matrícula. Nunca é parâmetro de ferramenta MCP.
WINTHOR_SENHA=troque-esta-senha

# --- Comportamento -----------------------------------------------------------

# Validade, em segundos, do cache de catálogo e de permissão.
WINTHOR_CACHE_SEGUNDOS=300

# Libera operações de escrita via WTA. Mantenha false a menos que você saiba
# exatamente o que está habilitando.
WINTHOR_PERMITIR_ESCRITA=false

# --- Servidor remoto multiusuário (OAuth) ------------------------------------

# URL pública por onde os clientes MCP (Claude, Cursor) chegam. Ativa o modo
# remoto com OAuth: cada pessoa loga com a própria matrícula e senha do WinThor.
# Sem ela, o servidor roda em stdio local com a identidade fixa acima.
WINTHOR_PUBLIC_URL=https://winthor-mcp.suaempresa.com.br

# Janela da sessão do navegador antes de exigir novo login (o token do WTA, de
# 4h, é renovado por baixo sem tocar nisto).
WINTHOR_SESSAO_HORAS=12
